[gd_resource type="Resource" script_class="DatosGlosario" load_steps=2 format=3]

[ext_resource type="Script" path="res://datos/clases/datos_glosario.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
terminos = [{
"corto": "Partículas de alta energía que dañan las células. Marte no tiene un campo magnético global ni una atmósfera densa que la frene.",
"detalle": "En la superficie de Marte llegan dos tipos de radiación: los rayos cósmicos galácticos, partículas muy energéticas que vienen de fuera del sistema solar, y las partículas solares, que el Sol lanza en ráfagas.\n\nEl instrumento RAD del rover Curiosity midió en la superficie una dosis media de unos 0,7 milisieverts al día: en un año, varias veces el límite anual para trabajadores expuestos en la Tierra. La dosis acumulada aumenta el riesgo de cáncer y de daños en el sistema nervioso.\n\nLa NASA no deja que sus astronautas pasen de 600 milisieverts en toda su carrera (norma NASA-STD-3001): al llegar al límite ya no vuelan. Por eso en el juego un colono con mucha radiación tiene que volver a la Tierra.\n\nEn el juego, cada colono acumula radiación al trabajar en el exterior; a partir de 100 enferma.",
"id": "radiacion",
"nombre": "Radiación espacial",
"palabras": ["radiación"]
}, {
"corto": "Ráfaga de partículas cargadas que el Sol lanza al espacio. En Marte puede multiplicar la dosis de radiación en pocas horas.",
"detalle": "Las tormentas solares (eventos de partículas solares y eyecciones de masa coronal) lanzan protones y otras partículas a gran velocidad. La Tierra está protegida por su magnetosfera; Marte no.\n\nEn septiembre de 2017 una tormenta solar alcanzó Marte: el rover Curiosity registró en la superficie el doble de radiación de lo normal, y la sonda MAVEN vio auroras en todo el planeta.\n\nLa protección principal es refugiarse tras una capa gruesa de material: agua, regolito o plástico rico en hidrógeno.",
"id": "tormenta_solar",
"nombre": "Tormenta solar",
"palabras": ["tormenta solar", "tormentas solares"]
}, {
"corto": "Zona de la base con paredes muy gruesas donde la tripulación se protege durante una tormenta solar.",
"detalle": "Los diseños de bases y naves tripuladas incluyen un refugio contra tormentas: un espacio pequeño rodeado de la mayor masa posible. Los materiales ricos en hidrógeno, como el agua o el polietileno, frenan especialmente bien las partículas solares.\n\nLa nave Orion de la NASA, por ejemplo, prevé que la tripulación se refugie en su zona central rodeada de bolsas y suministros durante una tormenta solar.\n\nEn el juego, cada refugio protege por completo a 5 colonos.",
"id": "refugio",
"nombre": "Refugio blindado",
"palabras": ["refugio blindado", "refugios blindados"]
}, {
"corto": "Capa de polvo, arena y roca suelta que cubre la superficie de Marte.",
"detalle": "El regolito marciano se formó por impactos de meteoritos y erosión durante miles de millones de años. Su color rojizo se debe a óxidos de hierro.\n\nEs un recurso valioso: puede usarse para construir (ladrillos, impresión 3D) o apilarse sobre los módulos como blindaje contra la radiación. Pero también es un problema: es muy fino, abrasivo y contiene percloratos tóxicos.",
"id": "regolito",
"nombre": "Regolito",
"palabras": ["regolito"]
}, {
"corto": "Sales tóxicas presentes en el suelo marciano que afectan a la tiroides.",
"detalle": "La sonda Phoenix descubrió en 2008 percloratos en el suelo de Marte, en una concentración de alrededor del 0,5 %. Otras misiones confirmaron que están repartidos por todo el planeta.\n\nSon tóxicos para las personas porque interfieren con la tiroides, así que el agua y el suelo de Marte tendrían que tratarse antes de usarlos para beber o cultivar. Curiosamente, algunas bacterias pueden descomponerlos y liberar oxígeno.",
"id": "perclorato",
"nombre": "Percloratos",
"palabras": ["perclorato", "percloratos"]
}, {
"corto": "Sistemas que mantienen el aire, el agua y la temperatura necesarios para vivir.",
"detalle": "Un sistema de soporte vital controla la presión, retira el dióxido de carbono, produce oxígeno y recicla el agua.\n\nEn la Estación Espacial Internacional, el sistema de recuperación de agua alcanzó en 2023 un reciclaje del 98 %: recupera agua del sudor, la humedad del aire y la orina. Una base en Marte necesitará sistemas así de eficaces, porque cada litro enviado desde la Tierra cuesta muchísimo.\n\nEn el juego, el soporte vital recicla el 80 % del agua que usa la tripulación. El 20 % que falta hay que sacarlo del hielo de Marte o pedirlo a la Tierra.",
"id": "soporte_vital",
"nombre": "Soporte vital",
"palabras": ["soporte vital"]
}, {
"corto": "Experimento del rover Perseverance que fabricó oxígeno a partir del dióxido de carbono de Marte.",
"detalle": "MOXIE (Mars Oxygen In-Situ Resource Utilization Experiment) viajó en el rover Perseverance. Entre 2021 y 2023 funcionó 16 veces y produjo en total unos 122 gramos de oxígeno, separando el dióxido de carbono de la atmósfera marciana.\n\nDemostró que se puede producir oxígeno en Marte, tanto para respirar como para fabricar combustible de cohetes para el viaje de vuelta.",
"id": "moxie",
"nombre": "MOXIE",
"palabras": ["moxie"]
}, {
"corto": "Cultivo de plantas fuera de la Tierra: en naves, estaciones o bases en otros mundos.",
"detalle": "Cultivar en Marte exige luz artificial o filtrada, agua reciclada y un suelo sin percloratos. Por eso se usan técnicas como la hidroponía, que cultiva las plantas en agua con nutrientes, sin tierra.\n\nEn la Estación Espacial Internacional, los experimentos Veggie y APH han cultivado lechugas, rábanos y chiles que los astronautas han llegado a comer.",
"id": "astroagronomia",
"nombre": "Astroagronomía",
"palabras": ["astroagronomía"]
}, {
"corto": "Fuente de energía de muchas misiones marcianas. Marte recibe menos luz que la Tierra y el polvo los cubre.",
"detalle": "Marte está más lejos del Sol y recibe alrededor del 43 % de la luz que llega a la Tierra. Además, el polvo se deposita sobre los paneles y reduce la producción.\n\nEl rover Opportunity funcionó con paneles solares casi 15 años, a veces gracias a ráfagas de viento que los limpiaban, hasta que una tormenta de polvo global en 2018 lo dejó sin energía.",
"id": "paneles_solares",
"nombre": "Paneles solares en Marte",
"palabras": ["paneles solares", "panel solar"]
}, {
"corto": "Tormentas que levantan polvo fino durante semanas; algunas cubren todo el planeta.",
"detalle": "Las tormentas de polvo son frecuentes en Marte. La mayoría son locales, pero cada varios años alguna crece hasta envolver todo el planeta durante semanas o meses.\n\nNo son tan violentas como en las películas, porque la atmósfera es muy fina, pero oscurecen el cielo, reducen la energía solar y meten polvo en los equipos. La tormenta global de 2018 terminó con la misión Opportunity.",
"id": "tormenta_polvo",
"nombre": "Tormenta de polvo",
"palabras": ["tormenta de polvo", "tormentas de polvo"]
}, {
"corto": "Retraso de las señales entre la Tierra y Marte por la distancia: de unos 3 a 22 minutos en cada sentido.",
"detalle": "Las señales de radio viajan a la velocidad de la luz, pero la distancia entre la Tierra y Marte varía mucho según la posición de los planetas. Un mensaje tarda entre unos 3 y 22 minutos en llegar, y otro tanto en volver la respuesta.\n\nPor eso una base marciana no podría pedir ayuda inmediata: tendría que tomar decisiones por su cuenta. Y los envíos de personas o suministros solo pueden salir cada unos 26 meses, cuando los planetas están bien alineados.",
"id": "latencia",
"nombre": "Latencia de comunicaciones",
"palabras": ["latencia"]
}, {
"corto": "Un día solar en Marte: 24 horas y unos 40 minutos.",
"detalle": "Las misiones a Marte cuentan el tiempo en soles. Un sol dura unas 24 horas y 40 minutos, solo un poco más que un día terrestre, y un año marciano tiene unos 668 soles.\n\nEn el juego, un sol dura 60 segundos de juego (menos con x2 y x4).\n\nLos equipos de las misiones en la Tierra a veces trabajan en hora de Marte, desplazando su horario 40 minutos cada día.",
"id": "sol_marciano",
"nombre": "Sol (día marciano)",
"palabras": ["día marciano"]
}, {"id": "llamarada", "nombre": "Llamarada solar", "palabras": ["llamarada solar", "llamaradas solares", "llamarada", "llamaradas"], "corto": "Un destello gigante en el Sol. Se miden con letras: A, B, C, M y X. Las X son las más fuertes.", "detalle": "Una llamarada solar es una explosión de luz y energía en el Sol. Cada letra es 10 veces más fuerte que la anterior: una M es 10 veces más fuerte que una C, y una X es 10 veces más fuerte que una M. El número dice cuánto dentro de esa letra: una X8.7 es casi 9 veces una X1.\n\nSu luz viaja a la velocidad de la luz, así que llega a Marte en unos 13 minutos. Puede estorbar las comunicaciones por radio.\n\nEn mayo de 2024 una región del Sol llamada AR3664 lanzó muchas llamaradas X seguidas. Una del 20 de mayo se estimó en X12 y apuntaba a Marte."}, {"id": "cme", "nombre": "Eyección de masa coronal (CME)", "palabras": ["eyección de masa coronal", "cme", "nube de plasma", "nubes de plasma", "nube del sol"], "corto": "Una nube enorme de plasma que el Sol lanza al espacio. Tarda uno o varios días en llegar a los planetas.", "detalle": "CME son las siglas en inglés de eyección de masa coronal. Es una nube de gas muy caliente (plasma) con campo magnético que sale disparada del Sol a cientos o miles de kilómetros por segundo.\n\nPara saber cuándo llega a Marte se divide la distancia entre la velocidad: Marte está a unos 228 millones de km del Sol. Una nube a 1200 km/s tarda 228 000 000 ÷ 1200 = 190 000 segundos, unas 53 horas.\n\nLa NASA usa una simulación por computadora llamada WSA-ENLIL para predecir a qué planetas llegará cada nube."}, {"id": "sep", "nombre": "Partículas energéticas solares (SEP)", "palabras": ["partículas energéticas solares", "lluvia de partículas"], "corto": "Partículas del Sol que viajan casi a la velocidad de la luz y suben mucho la radiación.", "detalle": "Cuando hay una llamarada o una CME muy fuerte, el Sol acelera protones y electrones a velocidades enormes. Llegan a Marte en minutos u horas.\n\nEl 20 de mayo de 2024 una de estas lluvias llegó a Marte: el detector RAD del rover Curiosity midió 8100 micrograys, como 30 radiografías de tórax, y la sonda MAVEN vio auroras en todo el planeta.\n\nLa mejor protección es un refugio con paredes gruesas, o una cueva o un acantilado."}, {"id": "tormenta_geomagnetica", "nombre": "Tormenta geomagnética e índice Kp", "palabras": ["tormenta geomagnética", "tormentas geomagnéticas", "tormenta magnética", "índice kp"], "corto": "Cuando el viento del Sol sacude el escudo magnético de la Tierra. Se mide con el índice Kp, de 0 a 9.", "detalle": "La Tierra tiene un escudo magnético que desvía casi todo lo que lanza el Sol. Cuando llega una CME, el escudo se sacude: eso es una tormenta geomagnética, y se ven auroras.\n\nEl índice Kp mide qué tan fuerte es, de 0 (calma) a 9 (extrema). El 10 y 11 de mayo de 2024 llegó a Kp 9, la tormenta más fuerte en más de 20 años.\n\nMarte no tiene un escudo magnético global, por eso sus colonos necesitan refugios."}, {"id": "viento_solar", "nombre": "Viento solar", "palabras": ["viento solar"], "corto": "Un chorro de partículas que el Sol lanza todo el tiempo en todas direcciones.", "detalle": "El Sol no se queda quieto: siempre está soplando partículas hacia el espacio a unos 400 km/s. A veces, desde zonas oscuras del Sol llamadas agujeros coronales, sale un viento solar mucho más rápido.\n\nNo es como el viento de Marte que mueve el polvo: el viento solar es invisible y viaja por el espacio."}, {"id": "escudo_magnetico", "nombre": "Escudo magnético (magnetosfera)", "palabras": ["escudo magnético", "magnetosfera"], "corto": "El campo magnético que rodea la Tierra y la protege de casi toda la radiación del Sol. Marte no lo tiene.", "detalle": "El centro de la Tierra tiene metal líquido en movimiento que crea un campo magnético. Ese campo forma un escudo invisible, la magnetosfera, que desvía las partículas del Sol.\n\nMarte perdió su escudo global hace miles de millones de años. Por eso en Marte la radiación es mucho más alta y las auroras pueden verse en todo el planeta."}, {"id": "donki", "nombre": "NASA DONKI", "palabras": ["donki"], "corto": "La base de datos de la NASA donde se registra todo lo que hace el Sol: llamaradas, nubes de plasma, tormentas y más.", "detalle": "DONKI significa, en inglés, base de datos de notificaciones, conocimiento e información del clima espacial. La mantiene el Centro de Modelado Coordinado de la Comunidad (CCMC) de la NASA, en Goddard.\n\nLos eventos del Sol de este juego salen de DONKI: si hay internet, el juego la consulta al empezar; si no, usa lo último que guardó o un archivo con eventos reales. Abajo a la izquierda, el indicador DONKI dice cuál está usando (el punto se pone verde cuando está en vivo)."}, {"id": "rad", "nombre": "Detector RAD del rover Curiosity", "palabras": ["detector rad", "curiosity"], "corto": "Un instrumento del rover Curiosity que mide la radiación en la superficie de Marte desde 2012.", "detalle": "RAD (Radiation Assessment Detector) mide cuánta radiación llega al suelo de Marte. Gracias a él sabemos que en la superficie un astronauta recibiría unos 0.64 milisieverts al día, y casi el triple durante el viaje en la nave (1.84 al día).\n\nEn mayo de 2024 midió la subida más grande desde que llegó: 8100 micrograys en un solo evento."}, {"id": "fuentes", "nombre": "Fuentes de datos reales", "palabras": ["dato real", "datos reales"], "corto": "Los eventos del Sol y los datos de radiación del juego son reales. Aquí dice de dónde salen.", "detalle": "Eventos del Sol: NASA DONKI (ccmc.gsfc.nasa.gov/DONKI). En vivo cuando hay internet; si no, el último guardado o el archivo del juego. Nunca se muestra como en vivo algo que no lo es.\n\nArchivo de mayo de 2024: Bureau of Meteorology de Australia (reporte del 9 de mayo de 2024), Wikipedia «May 2024 solar storms» y NASA/JPL «NASA Watches Mars Light Up During Epic Solar Storm».\n\nRadiación en Marte: detector RAD del rover Curiosity (Hassler y otros, revista Science, 2013).\n\nLímite de radiación de los astronautas: 600 milisieverts en toda la carrera, norma NASA-STD-3001.\n\nLo que pasa en la colonia (costos, soles, recursos) es del juego; lo que dice «lo que pasó de verdad» es real."}, {"id": "kw_kwh", "nombre": "kW y kWh: potencia y energía", "palabras": ["kilovatio", "kilovatios", "kwh"], "corto": "Los kW dicen cuánta electricidad se usa o se produce en cada momento. Los kWh dicen cuánta se guardó.", "detalle": "Piensa en una llave de agua: los kW (kilovatios) son qué tan fuerte sale el chorro, y los kWh (kilovatios hora) son cuánta agua juntaste en la cubeta.\n\nUn módulo que consume 20 kW durante 1 hora gasta 20 kWh. Un sol en Marte dura unas 24.66 horas, así que un módulo de 20 kW gasta unos 493 kWh por sol.\n\nEn el juego, los paneles y los módulos se miden en kW, y las baterías de la base guardan kWh. Si lo que se gasta es más que lo que se produce, las baterías se van vaciando."}, {"id": "reactor_fision", "nombre": "Reactor de fisión de superficie", "palabras": ["reactor de fisión", "reactores de fisión"], "corto": "Un reactor nuclear pequeño que la NASA desarrolla para dar electricidad en la Luna y Marte, de día y de noche.", "detalle": "El proyecto Fission Surface Power de la NASA busca un reactor de al menos 40 kW: suficiente para mantener encendidas unas 30 casas durante diez años.\n\nA diferencia de los paneles solares, no depende de la luz del Sol ni se cubre de polvo.\n\nEn el juego, la base empieza con 100 kW: dos reactores de 40 kW y un panel solar de 20 kW."}, {"id": "hielo_marte", "nombre": "Hielo de Marte", "palabras": ["hielo de marte", "perforadora de hielo", "perforadora"], "corto": "Bajo el suelo de Marte hay capas de hielo de agua. Se puede perforar, derretir y usar.", "detalle": "Las sondas han encontrado hielo de agua bajo la superficie de Marte, sobre todo lejos del ecuador. Sacarlo permitiría tener agua para beber, para cultivar y para fabricar oxígeno.\n\nUna idea que estudia la NASA es el pozo Rodwell: se perfora el hielo, se calienta para formar una alberca de agua bajo tierra y se bombea hacia arriba. Un estudio de la NASA calculó que unos 10 kW de calor bastan para sacar unos 379 litros al día.\n\nEn el juego, la perforadora de hielo da 5 litros por sol y gasta 10 kW."}, {"id": "gravedad_marte", "nombre": "Gravedad de Marte", "palabras": ["gravedad"], "corto": "La fuerza que te jala hacia el suelo. En Marte es el 38 % de la de la Tierra.", "detalle": "La gravedad depende de cuánta masa tiene un planeta. Marte es más pequeño que la Tierra, así que jala menos: el 38 %.\n\nUna mochila de 10 kg en la Tierra se sentiría en Marte como de 3.8 kg (10 x 0.38). Pero ojo: con poca gravedad los músculos y los huesos trabajan menos y se debilitan, por eso los astronautas hacen ejercicio todos los días.\n\nFuente: NASA/JPL, «Mars at a Glance»."}, {"id": "atmosfera_marte", "nombre": "Atmósfera de Marte", "palabras": ["dióxido de carbono", "atmósfera"], "corto": "El aire de Marte: 95 % dióxido de carbono y muy delgado. No se puede respirar.", "detalle": "La atmósfera de Marte tiene 95.3 % de dióxido de carbono, 2.7 % de nitrógeno y 1.6 % de argón, y casi nada de oxígeno.\n\nEs tan delgada que su presión es menos de la centésima parte de la de la Tierra. Por eso los colonos necesitan trajes y módulos sellados, y por eso casi no frena la radiación del Sol.\n\nFuente: NASA/JPL, «Mars at a Glance»."}, {"id": "lunas_marte", "nombre": "Fobos y Deimos", "palabras": ["fobos", "deimos"], "corto": "Las dos lunas de Marte. Son pequeñas y de forma irregular, como papas.", "detalle": "Marte tiene dos lunas. La más grande se llama Fobos, que significa «miedo», y la más pequeña, Deimos, que significa «terror».\n\nSon mucho más pequeñas que nuestra Luna, y desde Marte se verían como lunas chiquitas en el cielo.\n\nFuente: NASA/JPL, «Mars at a Glance»."}, {"id": "monte_olimpo", "nombre": "Monte Olimpo", "palabras": ["monte olimpo"], "corto": "Un volcán gigante de Marte, de unos 26 km de alto: casi 3 veces el Everest.", "detalle": "El Monte Olimpo (Olympus Mons) es un volcán en escudo: muy ancho y con laderas suaves. Mide unos 26 km de alto, casi 3 veces el monte Everest (8.8 km), y es el punto más alto de Marte.\n\nFuente: NASA/JPL, «Mars at a Glance»."}, {"id": "impresion_3d", "nombre": "Impresión 3D", "palabras": ["impresión 3d", "pieza 3d"], "corto": "Fabricar objetos capa por capa con una máquina. Sirve para hacer repuestos lejos de la Tierra.", "detalle": "Una impresora 3D derrite un material, como plástico, y lo va poniendo capa por capa hasta formar una pieza.\n\nEn el espacio es muy útil: si algo se rompe, en vez de esperar meses a que llegue un repuesto, se imprime. La primera pieza impresa en el espacio se hizo en la Estación Espacial el 24 de noviembre de 2014.\n\nFuente: collectSPACE, noviembre de 2014."}, {"id": "rover", "nombre": "Rover", "palabras": ["rover"], "corto": "Un vehículo robot que recorre otro planeta, tomando fotos y haciendo experimentos.", "detalle": "Los rovers son laboratorios con ruedas. Se manejan desde la Tierra, pero como los mensajes tardan minutos en llegar (latencia), también saben moverse un poco solos.\n\nEn Marte han trabajado Sojourner, Spirit, Opportunity, Curiosity y Perseverance. Opportunity estaba hecho para 90 soles y funcionó unos 15 años.\n\nFuente: NASA Astrobiology, febrero de 2019."}, {"id": "huesos_espacio", "nombre": "Huesos en el espacio", "palabras": ["huesos", "densidad"], "corto": "Sin gravedad, los huesos pierden entre 1 % y 1.5 % de su densidad cada mes.", "detalle": "En la Tierra, caminar y cargar cosas hace trabajar a los huesos. En el espacio casi no tienen que sostener peso y se van debilitando: pierden entre 1 % y 1.5 % de su densidad cada mes en misiones de 4 a 6 meses.\n\nPor eso los astronautas hacen ejercicio todos los días y les revisan los huesos antes y después del viaje.\n\nFuente: NASA, «Risk of Spaceflight-Induced Bone Changes»."}]
